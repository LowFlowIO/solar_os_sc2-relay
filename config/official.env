# SC2 relay: example configuration for the OFFICIAL relay (v2 only).
# Copy to /etc/sc2-relay/official.env (or pass with docker --env-file) and
# replace the example values. Everything here is documented in README.md.

SC2_PROFILE=official
SC2_RELAY_ID=relay.example.org
SC2_DATA_DIR=/data

# chats:// on 7778 with a Let's Encrypt certificate. The certbot sidecar in
# docker-compose.yml (or plain certbot, see README.md "TLS") writes
# /certs/fullchain.pem and /certs/privkey.pem with --reuse-key; the relay
# reads those two files and hot-reloads them on renewal.
SC2_ACME_DOMAIN=relay.example.org
SC2_ACME_EMAIL=ops@example.org
# SC2_ACME_STAGING=true          # test against the Let's Encrypt staging CA first
# SC2_ACME_WEBROOT=/var/www/acme # HTTP-01 via an existing web server instead of :80 standalone
SC2_ACME_CERT_DIR=/certs
SC2_TLS_RELOAD_INTERVAL=60
SC2_TLS_PORT=7778
# No plain chat:// on the official relay.
SC2_PLAIN=false

# HTTP for /.well-known, /healthz, /metrics, the web view and wss:///sc2.
# Put a reverse proxy (Caddy/Traefik) with TLS in front of it.
SC2_HTTP_PORT=8080
SC2_WEBSOCKET=true
SC2_TRUST_PROXY=true

# Legacy v1 is never enabled on the official relay: v1 hello gets 426.
SC2_LEGACY_V1=false

# Open registration, no device attestation.
SC2_ADMISSION=open

# Store-and-forward limits.
SC2_TTL_DAYS=7
SC2_MAX_QUEUE=500
SC2_MAX_QUEUE_BYTES=5242880

# Public rooms come from config; clients cannot create them.
SC2_PUBLIC_ROOMS=general
SC2_PUBLIC_ROOM_CREATE=operator
SC2_PUBLIC_BODY_MAX=1024
SC2_PUBLIC_LOG_MAX=10000

# Read-only web view of public rooms, not indexed by search engines.
SC2_WEB_VIEW=true
SC2_WEB_NOINDEX=true

# Anti-spam: rate limits and slow mode only. No mutes.
SC2_POST_PER_MIN=10
SC2_POST_BURST=5
SC2_IP_POST_PER_MIN=30
SC2_IP_POST_BURST=10
SC2_ROOM_POST_PER_MIN=600
SC2_SLOW_KEY_MINUTES=10
SC2_SLOW_PER_MIN=2
SC2_SLOW_BODY_MAX=256
SC2_MUTES=false

# Admin API on loopback only, bearer token required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SC2_ADMIN_LISTEN=127.0.0.1:7780
SC2_ADMIN_TOKEN=change-me-to-a-long-random-token

SC2_LOG_LEVEL=INFO
SC2_LOG_DEVICE_IDS=false

# Connection slots (README: Connection slots). Pings do not reset the idle
# timer; when full, a new login may displace a session idle this long.
# SC2_IDLE_TIMEOUT=300
# SC2_EVICT_MIN_IDLE=60
# SC2_MAX_SESSION_SECONDS=0
