# SC2 relay: example configuration for a SELF-HOSTED relay.
# Defaults: legacy v1 on for existing devices, web view off.

SC2_PROFILE=selfhost
SC2_RELAY_ID=chat.home.example
SC2_DATA_DIR=/data

# chats:// with your own certificate (self-signed is fine: clients pin it with
# chats://chat.home.example:7778#pin=sha256/<tls_pin from /.well-known>).
SC2_TLS_CERT=/certs/cert.pem
SC2_TLS_KEY=/certs/key.pem
SC2_TLS_PORT=7778
# Or a Let's Encrypt certificate through the certbot sidecar (public DNS name
# and port 80 reachable): drop the two lines above and set
# SC2_ACME_DOMAIN=chat.example.org
# SC2_ACME_EMAIL=you@example.org

# Plain chat:// on 7777 for a trusted LAN only (metadata visible on the LAN;
# content stays end-to-end encrypted, auth is a signature challenge).
SC2_PLAIN=false
SC2_PLAIN_PORT=7777

SC2_HTTP_PORT=8080
SC2_WEBSOCKET=true

# Legacy v1 (INSECURE: unencrypted, unsigned) for existing SolarOS gateways.
# Separate namespace, never bridged to SC2 rooms. Set false to answer 426.
SC2_LEGACY_V1=true
# Optional v1 token (the chatd "token" setting).
SC2_LEGACY_V1_TOKEN=

# Registration: open | code (hello.admit must match) | allowlist.
SC2_ADMISSION=code
SC2_ADMIT_CODE=change-me
#SC2_ALLOWLIST=<32-hex device id>,<32-hex device id>

SC2_PUBLIC_ROOMS=general
SC2_PUBLIC_ROOM_CREATE=operator
SC2_WEB_VIEW=false

# Self-hosters may enable mutes (403 muted with until).
SC2_MUTES=false

SC2_ADMIN_LISTEN=127.0.0.1:7780
SC2_ADMIN_TOKEN=change-me-to-a-long-random-token

# Connection slots (README: Connection slots). Pings do not reset the idle
# timer; when full, a new login may displace a session idle this long.
# SC2_IDLE_TIMEOUT=300
# SC2_EVICT_MIN_IDLE=60
# SC2_MAX_SESSION_SECONDS=0
